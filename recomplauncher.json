{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Bomberman Online",
  "repo": "nvd123-YT/BombermanOnlineRecomp",
  "game": {
    "kind": "iso",
    "label": "Your own USA Bomberman Online Dreamcast disc image (MK-51065 V1.004). Supported formats: .chd, .gdi, or .cue with its .bin tracks.",
    "dumps": [
      {
        "name": "USA CUE sheet (descriptor only)",
        "size": 360,
        "crc32": "77e7cba3"
      }
    ]
  },
  "start": {
    "program": [
      "Bomberman Online Launcher.exe",
      "Bomberman Online Launcher-win32-x64/Bomberman Online Launcher.exe",
      "win-unpacked/Bomberman Online Launcher.exe",
      "Bomberman Online Launcher.app",
      "mac-arm64/Bomberman Online Launcher.app",
      "mac-x64/Bomberman Online Launcher.app",
      "Bomberman Online Launcher.AppImage"
    ],
    "args": [
      "--game",
      "{game}"
    ]
  },
  "settings": [
    {
      "id": "render_scale",
      "label": "Resolution",
      "group": "Video",
      "in": "args",
      "help": "The listed pixel dimensions are achieved when Aspect ratio is set to Widescreen (16:9). With Original (4:3), the render target keeps 4:3 proportions.",
      "choices": [
        {
          "label": "Native (640 × 480 at 4:3)",
          "args": []
        },
        {
          "label": "720p (1.5×; 1280 × 720 at 16:9)",
          "args": [
            "--bmo-scale",
            "1.5"
          ]
        },
        {
          "label": "1080p (2.25×; 1920 × 1080 at 16:9)",
          "args": [
            "--bmo-scale",
            "2.25"
          ]
        },
        {
          "label": "1440p (3×; 2560 × 1440 at 16:9)",
          "args": [
            "--bmo-scale",
            "3"
          ]
        },
        {
          "label": "4K (4.5×; 3840 × 2160 at 16:9)",
          "args": [
            "--bmo-scale",
            "4.5"
          ]
        },
        {
          "label": "8K (9×; 7680 × 4320 at 16:9)",
          "args": [
            "--bmo-scale",
            "9"
          ]
        }
      ]
    },
    {
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "group": "Video",
      "in": "args",
      "choices": [
        {
          "label": "Original (4:3)",
          "args": []
        },
        {
          "label": "Widescreen (16:9)",
          "args": [
            "--bmo-widescreen"
          ]
        }
      ]
    },
    {
      "id": "vsync",
      "label": "VSync",
      "group": "Video",
      "in": "args",
      "choices": [
        {
          "label": "Off",
          "args": []
        },
        {
          "label": "On",
          "args": [
            "--bmo-vsync"
          ]
        }
      ]
    },
    {
      "id": "display_mode",
      "label": "Display mode",
      "group": "Video",
      "in": "args",
      "choices": [
        {
          "label": "Follow RecompLauncher mode",
          "args": []
        },
        {
          "label": "Windowed",
          "args": [
            "--bmo-windowed"
          ]
        },
        {
          "label": "Fullscreen",
          "args": [
            "--bmo-fullscreen"
          ]
        }
      ]
    },
    {
      "id": "fps_counter",
      "label": "FPS counter",
      "group": "Video",
      "in": "args",
      "choices": [
        {
          "label": "Off",
          "args": []
        },
        {
          "label": "On",
          "args": [
            "--bmo-fps"
          ]
        }
      ]
    },
    {
      "id": "audio",
      "label": "Audio",
      "group": "Audio",
      "in": "args",
      "choices": [
        {
          "label": "On",
          "args": []
        },
        {
          "label": "Off",
          "args": [
            "--bmo-no-audio"
          ]
        }
      ]
    },
    {
      "id": "online",
      "label": "Online play",
      "group": "Online",
      "in": "args",
      "help": "Enable Bomberman Online's DCNet connection. Requires a working internet connection.",
      "choices": [
        {
          "label": "Off",
          "args": []
        },
        {
          "label": "On (DCNet)",
          "args": [
            "--bmo-online"
          ]
        }
      ]
    },
    {
      "id": "connection",
      "label": "Connection type",
      "group": "Online",
      "in": "args",
      "help": "Choose the connection emulated by the game. The Broadband Adapter is recommended for most players.",
      "choices": [
        {
          "label": "Broadband Adapter",
          "args": []
        },
        {
          "label": "Modem",
          "args": [
            "--bmo-modem"
          ]
        }
      ]
    }
  ],
  "requires": [
    "settings.args",
    "settings.groups"
  ]
}
